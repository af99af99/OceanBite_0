<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:background="#FFFFFF">

    <!-- Background Image (fixed 300dp height) -->

    <!-- Text and Button Section (below image) -->
    <ImageView
        android:id="@+id/bgImage"
        android:layout_width="400dp"
        android:layout_height="573dp"
        android:scaleType="fitXY"
        android:src="@drawable/welcome" />

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="16dp">

        <!-- HUNGRY Text -->
        <TextView
            android:id="@+id/tvHungry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HUNGRY?"
            android:textColor="#F30F5473"
            android:textSize="36sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Let's order and eat."
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Start Feast Button -->
        <Button
            android:id="@+id/btnStartFeast"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="Start Feast"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:backgroundTint="#F30F5473"
            android:layout_marginTop="16dp"/>
    </LinearLayout>

</LinearLayout>
