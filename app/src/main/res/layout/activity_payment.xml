<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PaymentActivity">

    <!-- Fullscreen Background Image -->
    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="390dp"
        android:layout_height="450dp"
        android:scaleType="centerCrop"
        android:src="@drawable/delivery"
        android:layout_gravity="bottom|center_horizontal" />

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:padding="16dp"
        android:clipToPadding="false"
        android:fitsSystemWindows="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Transparent Glass Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="30dp"
                android:paddingBottom="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#66FFFFFF"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#33FFFFFF">  <!-- inner background: more transparent -->

                <!-- Delivery Address -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Delivery Address"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#000000"
                    android:layout_margin="6dp" />

                <EditText
                    android:id="@+id/addressInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter your address"
                    android:background="@drawable/input_field"
                    android:padding="12dp"
                    android:layout_margin="6dp"
                    android:textColor="#000000"
                    android:textColorHint="#999999" />

                <!-- Payment Method -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Payment Method"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#000000"
                    android:layout_margin="6dp" />

                <RadioGroup
                    android:id="@+id/paymentMethodGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_margin="6dp">

                    <!-- bKash Button -->
                    <RadioButton
                        android:id="@+id/bkashOption"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:button="@null"
                        android:background="@drawable/bkash"
                        android:layout_marginEnd="16dp" />

                    <!-- Nagad Button -->
                    <RadioButton
                        android:id="@+id/nogodOption"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:button="@null"
                        android:background="@drawable/nagad" />
                </RadioGroup>

                <!-- Optional Payment Input Box -->
                <EditText
                    android:id="@+id/paymentInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Payment Number / Details"
                    android:background="@drawable/input_field"
                    android:padding="12dp"
                    android:layout_margin="6dp"
                    android:textColor="#000000"
                    android:textColorHint="#999999" />

                <!-- Payment Button -->
                <Button
                    android:id="@+id/paymentButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="PAY NOW"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_margin="6dp"
                    android:background="@drawable/button_yellow_rounded" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
    </FrameLayout>
