<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".DetailActivity">

    <!-- Fullscreen Background Image -->
    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/detailback" />

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:padding="16dp"
        android:clipToPadding="false">

        <!-- Wrapper to prevent CardView full height -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                android:layout_marginTop="40dp"
                app:cardBackgroundColor="#99FFFFFF"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@android:color/transparent">

                    <!-- Top Image -->
                    <ImageView
                        android:id="@+id/detailimage"
                        android:layout_width="match_parent"
                        android:layout_height="280dp"
                        android:scaleType="centerCrop"
                        app:srcCompat="@drawable/girlbackground" />

                    <!-- Food Name -->
                    <TextView
                        android:id="@+id/detailname"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Food Name"
                        android:textAlignment="center"
                        android:textColor="#000000"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/allerta"
                        android:paddingTop="12dp"
                        android:paddingBottom="8dp" />

                    <!-- Quantity -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:id="@+id/addcart"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/circle_background"
                            android:padding="5dp"
                            app:srcCompat="@drawable/adds" />

                        <TextView
                            android:id="@+id/foodquantity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1"
                            android:textSize="18sp"
                            android:textColor="#000000"
                            android:textStyle="bold"
                            android:layout_marginHorizontal="12dp"
                            android:gravity="center" />

                        <ImageView
                            android:id="@+id/subtract"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/circle_background"
                            android:padding="5dp"
                            app:srcCompat="@drawable/min" />
                    </LinearLayout>

                    <!-- Description -->
                    <TextView
                        android:id="@+id/fooddesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Meaty portobella mushrooms make for the perfect vegetarian burger!"
                        android:textColor="#555555"
                        android:textSize="14sp"
                        android:layout_marginBottom="12dp"
                        android:fontFamily="@font/allerta" />

                    <!-- Name Input -->
                    <EditText
                        android:id="@+id/namebox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Your Name"
                        android:padding="12dp"
                        android:background="@drawable/input_field"
                        android:layout_marginBottom="10dp"
                        android:textColor="#000000"
                        android:textColorHint="#999999"
                        android:fontFamily="@font/allerta" />

                    <!-- Phone Input -->
                    <EditText
                        android:id="@+id/phonebox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Phone"
                        android:inputType="phone"
                        android:padding="12dp"
                        android:background="@drawable/input_field"
                        android:layout_marginBottom="10dp"
                        android:textColor="#000000"
                        android:textColorHint="#999999"
                        android:fontFamily="@font/allerta" />

                    <!-- Price -->
                    <TextView
                        android:id="@+id/detailprice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Price ৳15.00"
                        android:textColor="#FF0000"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:gravity="center"
                        android:layout_marginBottom="4dp"
                        android:fontFamily="@font/allerta" />

                    <!-- Button -->
                    <Button
                        android:id="@+id/insertbutton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:minHeight="48dp"
                        android:text="ORDER NOW"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:fontFamily="@font/allerta"
                        android:background="@drawable/button_yellow_rounded"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:backgroundTint="@null"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="12dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
